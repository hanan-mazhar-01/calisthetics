rules_version = '2';

// Each signed-in user can read, write and delete only their own document,
// users/{uid}. Guests are never signed in, so they reach nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'email'])
        && request.resource.data.data is map;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
